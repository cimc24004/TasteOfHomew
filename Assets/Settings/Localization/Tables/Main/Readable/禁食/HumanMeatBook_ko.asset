  m_TableData:
  - m_Id: 13153132544
    m_Localized: "\uC774 \uCC45\uC740 \uC608\uB85C\uBD80\uD130 \uC804\uD574 \uB0B4\uB824\uC624\uB294
      \uAE08\uAE30\uC758 \uAD00\uC2B5\uC744 \uC815\uB9AC\uD55C \uAC83\uC774\uB2E4.\n\uC0AC\uB78C\uC774
      \uC0AC\uB78C\uC744 \uBA39\uB294 \uAC83\uC740 \uAC00\uC7A5 \uD610\uC624\uC2A4\uB7EC\uC6B4
      \uD589\uC704\uB85C \uC5EC\uACA8\uC9C0\uBA70 \uC808\uB300 \uC2E4\uCC9C\uD574\uC11C\uB294
      \uC548 \uB41C\uB2E4.\n\uD558\uC9C0\uB9CC \uC5ED\uC0AC\uB97C \uB3CC\uC774\uCF1C\uBCF4\uBA74
      \uADF9\uD55C\uC758 \uC0C1\uD669\uC774\uB098 \uC758\uC2DD\uC774\uB77C\uB294
      \uBA85\uBAA9\uC73C\uB85C \uBC18\uBCF5\uB418\uC5B4 \uC654\uB2E4.\n\uC544\uB798\uC5D0
      \uAE30\uB85D\uD558\uB294 \uAC83\uC740 \uADF8 \"\uAE30\uB85D\"\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 83562913792
    m_Localized: "\uC5EC\uB7EC \uAE30\uADFC\uC758 \uC2DC\uB300\uC5D0 \uB9C8\uC744
      \uC0AC\uB78C\uB4E4\uC740 \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574 \uAE08\uAE30\uB97C
      \uAE7C\uB2E4.\n\uBA3C \uB098\uB77C\uC758 \uC804\uC7C1\uC5D0\uC11C\uB3C4 \uAD76\uC8FC\uB9B0
      \uBCD1\uC0AC\uB4E4\uC774 \uB3D9\uB8CC\uC5D0\uAC8C \uC190\uC744 \uBED7\uC5C8\uB2E4\uB294
      \uC774\uC57C\uAE30\uAC00 \uB0A8\uC544\uC788\uB2E4.\n\uB9CE\uC740 \uAE30\uB85D\uC774
      \uC18C\uAC01\uB418\uC5C8\uC9C0\uB9CC \uACA8\uC6B0 \uB0A8\uC740 \uC870\uAC01\uB4E4\uC774
      \uC774 \uB545\uC5D0\uB3C4 \uC804\uD574\uC9C0\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86595395584
    m_Localized: "\uC61B\uB0A0 \uC0AC\uB78C\uB4E4\uC740 \uBA39\uC740 \uACE0\uAE30\uB97C
      \"\uD608\uC721\uC744 \uC787\uB294 \uAC83\"\uC774\uB77C\uACE0 \uBD88\uB800\uB2E4.\n\uADF8\uAC83\uC740
      \uC870\uC758\uC774\uC790 \uD798\uC744 \uC5BB\uB294 \uC758\uC2DD\uC774\uAE30\uB3C4
      \uD588\uB2E4.\n\uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0 \uC808\uB300 \uC785 \uBC16\uC5D0
      \uB0B4\uC11C\uB294 \uC548 \uB418\uB294 \"\uC9D1\uC548\uC758 \uBE44\uBC00\"\uC774\uAE30\uB3C4
      \uD588\uB2E4.\n\uADF8\uAC83\uC744 \uC544\uB294 \uC790\uB294 \uBC18\uB4DC\uC2DC
      \uC9D1\uC5D0 \uC5BD\uB9E4\uC774\uB294 \uC6B4\uBA85\uC5D0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 89107783680
    m_Localized: "\uC774 \uAE30\uB85D\uB4E4\uC740 \uC5B4\uB290 \uAC83\uB3C4 \uC0AC\uB78C\uC758
      \uC785\uC5D0 \uC62C\uB824\uC11C\uB294 \uC548 \uB41C\uB2E4.\n\uB2E8\uC9C0 \"\uC54C\uC544\uBC84\uB9B0
      \uC790\"\uB9CC\uC774 \uADF8 \uBB34\uAC8C\uB97C \uC548\uACE0 \uC0B0\uB2E4.\n\uC774
      \uCC45\uC744 \uB36E\uC740 \uD6C4\uC5D0\uB3C4 \uAE30\uC5B5\uC740 \uC0AC\uB77C\uC9C0\uC9C0
      \uC54A\uC744 \uAC83\uC774\uB2E4.\n\uD558\uC9C0\uB9CC \uB5A0\uC62C\uB824\uC11C\uB294
      \uC548 \uB41C\uB2E4. \uADC0\uB97C \uAE30\uC6B8\uC774\uBA74\u2014\u2014\n\uC5B4\uB514\uC120\uAC00
      \"\uB0A8\uAE30\uC9C0 \uB9D0\uACE0 \uBA39\uC5B4\uB77C\"\uB77C\uACE0 \uC18D\uC0AD\uC774\uB294
      \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uBC84\uB9AC\uAE30 \uB54C\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12741125136384
    m_Localized: "\uAE08\uAE30\uC2DD \uACE0\uCC30"
    m_Metadata:
      m_Items: []

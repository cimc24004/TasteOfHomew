  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: HumanMeatBook_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: a14ad5b7de3de3f41bf9d474a2a969f5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13153132544
    m_Localized: "This book is a record of age-old, forbidden customs.\nThe act of
      man consuming man is held as the most abominable of deeds, one that must never
      be practiced.\nYet, throughout history, it has been repeated\u2014in times
      of dire need, or in the name of ritual.\nWhat is written herein is that record."
    m_Metadata:
      m_Items: []
  - m_Id: 83562913792
    m_Localized: 'During ages of great famine, villagers broke the taboo simply to
      survive.

      Stories also remain from wars in distant lands, of starving
      soldiers who turned upon their own comrades.

      Though many records were
      burned, the few fragments that remain have been passed down even to this land.

'
    m_Metadata:
      m_Items: []
  - m_Id: 86595395584
    m_Localized: 'The people of old called the flesh they consumed "That which continues
      the kin.

      " It was an act of mourning, and at the same time, a ritual
      to gain power. But it was also deemed a "family secret," never to be spoken
      of to outsiders

      Those who know of it are destined to be shackled by
      the family.

'
    m_Metadata:
      m_Items: []
  - m_Id: 89107783680
    m_Localized: "None of these records should ever pass human lips.\nOnly those
      who have come to know must live on, bearing its weight.\nEven after you close
      this book, the memory will not fade. But you must not recall it.\nFor if you
      listen closely\u2014 you will hear a voice whispering from somewhere, \"Finish
      your plate.\"\n"
    m_Metadata:
      m_Items: []
  - m_Id: 12741125136384
    m_Localized: A Study of Taboo Food
    m_Metadata:
      m_Items: []
  references:
    version: 2

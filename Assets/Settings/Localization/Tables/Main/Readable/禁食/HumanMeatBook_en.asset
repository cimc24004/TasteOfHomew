  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: HumanMeatBook_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: a14ad5b7de3de3f41bf9d474a2a969f5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13153132544
    m_Localized: 'This book compiles the forbidden practices passed down from ancient
      times.

      The act of humans consuming humans is considered the most abominable,
      and must never be practiced.

      Yet looking back through history, under
      extreme circumstances or in the name of rituals, it has been repeated.

      What
      follows is that "record."'
    m_Metadata:
      m_Items: []
  - m_Id: 83562913792
    m_Localized: 'During many famines, villagers broke the taboo to survive.

      Even
      in distant wars, stories remain of starving soldiers reaching for their comrades.

      Many
      records were burned, but fragments that survived have been passed down even
      to this land.'
    m_Metadata:
      m_Items: []
  - m_Id: 86595395584
    m_Localized: 'People of old called the consumed flesh "that which inherits kin."

      It
      was mourning, and also a ritual to gain power.

      Yet at the same time,
      it was a "family secret" that must never be spoken.

      Those who know it
      are destined to be bound to the house.'
    m_Metadata:
      m_Items: []
  - m_Id: 89107783680
    m_Localized: "These records should never be spoken by anyone.\nOnly \"those who
      have learned\" must live carrying this weight.\nEven after closing this book,
      the memories won't fade.\nBut you must not remember. Because if you listen
      closely\u2014\nyou'll hear a voice from somewhere whispering \"eat it all.\""
    m_Metadata:
      m_Items: []
  - m_Id: 12741125136384
    m_Localized: Thoughts on Forbidden Consumption
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

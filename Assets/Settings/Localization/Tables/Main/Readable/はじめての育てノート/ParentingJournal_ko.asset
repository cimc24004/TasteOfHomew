  m_TableData:
  - m_Id: 5116846080
    m_Localized: "4\uC6D4 12\uC77C\n\uC624\uB298 \uCF00\uC774\uD0C0\uAC00 \uCC98\uC74C\uC73C\uB85C
      \uC18C\uB9AC \uB0B4\uC5B4 \uC6C3\uC5C8\uB2E4.\n\uC544\uBE60\uAC00 \uC774\uC0C1\uD55C
      \uC5BC\uAD74\uC744 \uD558\uC790 \uBC29\uAE0B \uC6C3\uC73C\uBA70 \uC190\uC744
      \uBED7\uC5C8\uB2E4.\n\uC774\uB7F0 \uC791\uC740 \uC77C\uC774 \uC774\uB807\uAC8C
      \uAE30\uC060 \uC904\uC740 \uBAB0\uB790\uB2E4.\n\uBC24\uC5D0\uB294 \uC14B\uC774
      \uD568\uAED8 \uBAA9\uC695\uD558\uACE0, \uADF8 \uC560\uC758 \uC190\uC744 \uAF2D
      \uC7A1\uACE0 \uC7A4\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 25375334400
    m_Localized: "5\uC6D4 8\uC77C\n\uC624\uB298 \uB3D9\uB124\uC758 \uBBF8\uC640 \uC528\uAC00
      \uB180\uB7EC \uC654\uB2E4. \uB0B4\uAC00 \uC544\uAE30(\uCF00\uC774\uD0C0)\uB97C
      \uC548\uACE0 \uC788\uC73C\uB2C8 \uADF8\uB140\uAC00 \uBD80\uB7EC\uC6B4 \uB4EF
      \uAC00\uB9CC\uD788 \uCCD0\uB2E4\uBCF4\uB294 \uAC8C \uC778\uC0C1\uC801\uC774\uC5C8\uB2E4.
      \"\uAD1C\uCC2E\uC73C\uBA74\"\uC774\uB77C\uBA70 \uCF00\uC774\uD0C0\uB97C \uAC74\uB124\uC790,
      \uADF8\uB140\uB294 \uAE68\uC9C0\uAE30 \uC26C\uC6B4 \uBB3C\uAC74\uC744 \uB2E4\uB8E8\uB4EF
      \uC5B4\uC0C9\uD558\uC9C0\uB9CC \uC815\uB9D0 \uAE30\uC05C \uB4EF \uC548\uC544\uC92C\uB2E4.
      \uBD80\uC5CC\uC77C\uB3C4 \uB3C4\uC640\uC918\uC11C \uC815\uB9D0 \uB3C4\uC6C0\uC774
      \uB410\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 32967024640
    m_Localized: "6\uC6D4 28\uC77C\n\uC624\uB298\uC740 \uBBF8\uC640 \uC528\uAC00
      \uC870\uAE08 \uC774\uC57C\uAE30\uD574 \uC900 \uAC8C \uAC00\uC2B4\uC5D0 \uB0A8\uC558\uB2E4.\n\"\uC800\uB294
      \uC544\uC774\uB97C \uB0B3\uC744 \uC218 \uC5C6\uB294 \uBAB8\uC774\uC5D0\uC694\"\uB77C\uACE0
      \uB098\uC9C0\uB9C9\uC774 \uB9D0\uD588\uB2E4.\n\uB180\uB77C\uC11C \uC5B4\uCA54
      \uC904 \uBAB0\uB77C \uADF8\uB0E5 \uC548\uC544\uC92C\uB2E4.\n\uC785\uC7A5\uC774
      \uB2EC\uB77C\uB3C4 \uC0AC\uB78C\uC73C\uB85C\uC11C\uC758 \uC678\uB85C\uC6C0\uC740
      \uC54C \uC218 \uC788\uC73C\uB2C8 \uD0D3\uD560 \uC218\uAC00 \uC5C6\uC5C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 42219659264
    m_Localized: "7\uC6D4 15\uC77C\n\uBBF8\uC640 \uC528\uAC00 \uADF8 \uC560\uB97C
      \uC548\uC740 \uC5BC\uAD74\uC740 \uC544\uC8FC \uB2E4\uC815\uD588\uB2E4.\n\uD558\uC9C0\uB9CC
      \uAC00\uB054 \"\uADF8 \uC560\uAC00 \uB0B4 \uC544\uC774\uC600\uC73C\uBA74...\"\uC774\uB77C\uACE0
      \uB18D\uB2F4\uCC98\uB7FC \uB9D0\uD560 \uB54C\uAC00 \uC788\uB2E4.\n\uAC00\uC2B4\uC774
      \uB728\uB054\uD55C \uAC78 \uB290\uB07C\uC9C0\uB9CC \uC6C3\uC73C\uBA70 \uC5BC\uBC84\uBB34\uB9B0\uB2E4.\n\uCE5C\uAD6C\uAC00
      \uACC1\uC5D0 \uC788\uC5B4\uC8FC\uB294 \uAC74 \uACE0\uB9C8\uC6B4\uB370 \uC5B4\uB518\uAC00
      \uBCF5\uC7A1\uD55C \uAE30\uBD84\uB3C4 \uB4E0\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 48775356416
    m_Localized: "8\uC6D4 10\uC77C\n\uCF00\uC774\uD0C0\uB294 \uD655\uC2E4\uD788 \uB0B4
      \uC544\uC774\uB2E4. \uADF8 \uC0AC\uB78C\uACFC \uB098\uC758 \uC544\uC774.\n\uC544\uBB34\uB9AC
      \uD53C\uACE4\uD574\uB3C4 \uADF8 \uC560\uC758 \uC6C3\uB294 \uC5BC\uAD74\uC744
      \uBCF4\uBA74 \uAD6C\uC6D0\uBC1B\uB294\uB2E4.\n\uCE5C\uAD6C\uAC00 \uC788\uC5B4
      \uC9C0\uD0F1\uBC1B\uB294 \uB098\uB0A0\uC5D0\uB3C4 \uAC10\uC0AC\uD558\uC9C0\uB9CC,\n\uC5ED\uC2DC
      \uC774 \uC544\uC774\uB294 \uB0B4\uAC00 \uAC00\uC7A5 \uC18C\uC911\uD788 \uD558\uACE0
      \uC2F6\uB2E4.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 517333639168
    m_Localized: "\uCCAB \uC721\uC544 \uB178\uD2B8"

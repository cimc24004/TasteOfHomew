  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NiseParentingJournal_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 9c869184c2ee9f24fa15ac58249f3e37, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4831633408
    m_Localized: "\uCC3D\uBB38. \uCC3D\uBB38 \uB108\uBA38. \uC138 \uC0AC\uB78C\uC774
      \uC6C3\uACE0 \uC788\uB2E4. \"\uC544\uBE60\" \"\uC5C4\uB9C8\" \"\uC544\uAE30\".
      \uADF8 \uC5EC\uC790\uC758 \uD314 \uC548\uC5D0\uC11C \uC544\uAE30\uAC00 \uC6C3\uACE0
      \uC788\uB2E4. \uADF8\uAC74 \uB0B4 \uC790\uB9AC. \uADF8\uAC74 \uB0B4 \uAC70.
      \uC6D0\uD558\uB294 \uAC74 \uCF00\uC774\uD0C0\uBFD0."
    m_Metadata:
      m_Items: []
  - m_Id: 6597435392
    m_Localized: "\n\uADF8 \uB450 \uC0AC\uB78C\uC744 \uC8FD\uC774\uACA0\uC5B4. \uB0B4\uAC00
      \uC9C4\uC9DC \"\uC5C4\uB9C8\"\uAC00 \uB418\uACA0\uC5B4. \uCF00\uC774\uD0C0\uB97C
      \uADF8 \uC5EC\uC790\uC5D0\uAC8C\uC11C \"\uAD6C\uD574\uB0B4\uACA0\uC5B4\". \uB098\uB294
      \uC774\uBBF8 \uACB0\uC2EC\uD588\uC5B4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 8354848768
    m_Localized: "\uADF8 \uC5EC\uC790\uB294 \uC5B4\uB9AC\uC11D\uC5B4. \uB098\uB97C
      \uC644\uC804\uD788 \uBBFF\uACE0 \uC788\uC5B4. \uB098\uB294 \uD569\uC5F4\uC1E0\uAE4C\uC9C0
      \uAC00\uC9C0\uACE0 \uC788\uC5B4.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10095484928
    m_Localized: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uB450 \uC0AC\uB78C\uC744 \uC8FD\uC600\uB2E4.
      \uC544\uC8FC \uC870\uC6A9\uD588\uB2E4. \uC18C\uB9AC\uB3C4 \uB0B4\uC9C0 \uC54A\uACE0
      \uBD84\uD64D\uC0C9 \uBC29\uC5D0\uC11C \uB05D\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11953561600
    m_Localized: "\uC694\uB78C\uC5D0\uC11C \uC790\uACE0 \uC788\uB294 \uCF00\uC774\uD0C0\uB97C
      \uC548\uC544 \uC62C\uB838\uB2E4. \uB4DC\uB514\uC5B4 \uB418\uCC3E\uC558\uB2E4.
      \uB0B4 \uD488\uC5D0\uC11C \uCF00\uC774\uD0C0\uAC00 \uC6B8\uC5C8\uB2E4. \uAD1C\uCC2E\uC544.
      \uC774\uC81C \uAD1C\uCC2E\uC544. \"\uB0B4\uAC00 \uB124 \uC9C4\uC9DC \uC5C4\uB9C8\uC57C.\"
      \uC624\uB298\uBD80\uD130 \uC5EC\uAE30\uAC00 \uB098\uC640 \uB108\uC758 \"\uC9D1\"\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 13979410432
    m_Localized: "\uADF8 \uB450 \uC0AC\uB78C\uC744 \uC8FD\uC774\uACE0 \uC2DC\uCCB4\uB97C
      \uCC98\uB9AC\uD55C \uD6C4, \uBC14\uB2E5\uC5D0\uB294 \uD53C \uC5BC\uB8E9\uC774
      \uB300\uB7C9\uC73C\uB85C \uB0A8\uC558\uB2E4. \uB0C4\uC0C8\uB3C4 \uB054\uCC0D\uD588\uB2E4.
      \uC774 \uD754\uC801\uC744 \uC228\uAE30\uB824\uBA74 \uD45C\uBC31\uC81C\uB97C
      \uBFCC\uB9AC\uB294 \uAC8C \uAC00\uC7A5 \uBE68\uB790\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 15715852288
    m_Localized: "\uB098\uB294 \uC5C5\uBB34\uC6A9 \uAC15\uB825\uD55C \uD45C\uBC31\uC81C\uB97C
      \uBC14\uB2E5\uC774 \uD760\uBED1 \uC816\uC744 \uB9CC\uD07C \uB300\uB7C9\uC73C\uB85C
      \uBFCC\uB838\uB2E4. \uC774\uB807\uAC8C \uD558\uBA74 \uD53C\uC758 \uC0C9\uB3C4,
      \uB0C4\uC0C8\uB3C4, \uC5EC\uAE30\uC11C \uC77C\uC5B4\uB09C \uC77C\uC758 \uC99D\uAC70\uB3C4
      \uBAA8\uB450 \uC9C0\uC6B8 \uC218 \uC788\uB2E4. \uBC14\uB2E5\uC774 \uC5BC\uB8E9\uB35C\uB8E9\uD558\uAC8C
      \uD558\uC597\uAC8C \uBCC0\uD588\uC9C0\uB9CC, \uADF8\uB188\uB4E4\uC758 \uD754\uC801\uC774
      \uB0A8\uB294 \uAC83\uBCF4\uB2E4 \uD6E8\uC52C \uB0AB\uB2E4. \uC774\uC81C \uC774
      \uC9D1\uC740 \uB098\uC640 \uCF00\uC774\uD0C0\uB9CC\uC758 \"\uC9D1\"\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17347436544
    m_Localized: "\uD558\uC9C0\uB9CC \uADF8\uB188\uB4E4\uC744 \uC644\uBCBD\uD788
      \uC9C0\uC6E0\uB294\uB370\uB3C4 \uC774 \uC9D1\uC740 \uAC00\uB054 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4. \uD55C\uBC24\uC911\uC5D0 \uB2E4\uB2E4\uBBF8\uBC29\uC774\uB098
      \uAC70\uC2E4\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C \uB04C\uC5B4\uB2F9\uAE30\uB294
      \uB4EF\uD55C, \uC090\uAC71\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 19067101184
    m_Localized: "\uC544\uC9C1\uB3C4 \uC774 \uC9D1\uC5D0 \uB20C\uB7EC\uC549\uC73C\uB824\uACE0
      \uD55C\uB2E4. \uCF00\uC774\uD0C0\uC5D0\uAC8C \uB098\uC05C \uC601\uD5A5\uC774
      \uC788\uC73C\uBA74 \uC548 \uB3FC. \uADF8\uB798\uC11C \uADF8\uB188\uB4E4\uC774
      \uB098\uC624\uC9C0 \uBABB\uD558\uB3C4\uB85D \uC815\uD654\uC6A9 \uC18C\uAE08\uC744
      \uBFCC\uB9AC\uACE0 \uADF8 \uBD84\uD64D\uC0C9 \uBC29\uC5D0 \uBD80\uC801\uC744
      \uBD99\uC600\uB2E4. \uC774\uC81C \uADF8\uB188\uB4E4\uB3C4 \uC58C\uC804\uD574\uC9C8
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 20610605056
    m_Localized: "\uC9D1\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD55C \uADDC\uCE59\uC744
      \uBD99\uC600\uB2E4. \uCF00\uC774\uD0C0\uB294 \uB098\uB9CC \uBCF4\uBA74 \uB41C\uB2E4.
      \uADF8\uB7EC\uAE30 \uC704\uD574 \uC9D1 \uACF3\uACF3\uC5D0 \uC18C\uD615 \uAC10\uC2DC
      \uCE74\uBA54\uB77C\uB97C \uC124\uCE58\uD588\uB2E4. \uC774\uC81C \uACC4\uC18D
      \uAC10\uC2DC\uD560 \uC218 \uC788\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 22053445632
    m_Localized: "\uCF00\uC774\uD0C0\uAC00 \uC870\uAE08 \uCEF8\uC744 \uB54C, \uB098\uB294
      \uADF8 \uC560\uC5D0\uAC8C \"\uD615\uC81C\"\uAC00 \uD544\uC694\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uB2E4. \uB354 \uC644\uBCBD\uD55C \"\uAC00\uC871\"\uC744
      \uB9CC\uB4E4\uAE30 \uC704\uD574 \uBA87 \uBA85\uC758 \uAD1C\uCC2E\uC544 \uBCF4\uC774\uB294
      \uC560\uB4E4\uC744 \uB3D9\uB124\uC5D0\uC11C \uB370\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23508869120
    m_Localized: "\uD558\uC9C0\uB9CC \uC548 \uB410\uB2E4. \uC5B4\uB5A4 \uC560\uB3C4
      \uCF00\uC774\uD0C0\uCC98\uB7FC \uB098\uB97C \"\uC5C4\uB9C8\"\uB85C \uBCF4\uC9C0
      \uC54A\uC558\uB2E4. \uC6B8\uBD80\uC9D6\uAE30\uB9CC \uD558\uACE0 \uADDC\uCE59\uC744
      \uC9C0\uD0A4\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB188\uB4E4\uC740 \uCF00\uC774\uD0C0\uC758
      \"\uD615\uC81C\uC790\uB9E4\"\uAC00 \uB420 \uC218 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 24989458432
    m_Localized: "\uB9DE\uC9C0 \uC54A\uB294 \uB188\uB4E4\uC740 \uC2E4\uD328\uC791\uC774\uB2E4.
      \uD574\uCCB4\uD560 \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4. \uACB0\uAD6D \uB0B4
      \uC544\uC774\uB294 \uCF00\uC774\uD0C0\uB9CC \uC788\uC73C\uBA74 \uB41C\uB2E4.
      \uADF8 \uC560\uB9CC\uC774 \uB098\uC758 \uC644\uBCBD\uD55C \uC544\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26612654080
    m_Localized: "\uC624\uB298 \uCF00\uC774\uD0C0\uC5D0\uAC8C\uC11C \uADF8 '\uC4F0\uB808\uAE30'\uC640
      \uB9CC\uB0AC\uB2E4\uB294 \uC598\uAE30\uB97C \uB4E4\uC5C8\uC5B4. \uADDC\uCE59\uC744
      \uC5B4\uACBC\uC73C\uB2C8 \uBC8C\uC774 \uD544\uC694\uD558\uACA0\uB124. \uB098\uC758
      \uADC0\uC5EC\uC6B4 \uCF00\uC774\uD0C0\uB97C \uAF2C\uB4DC\uAE30\uB294 \uADF8
      \uC4F0\uB808\uAE30\uB97C \uCCAD\uC18C\uD560 '\uC815\uB2F9\uD55C \uBA85\uBD84'\uC774
      \uB4DC\uB514\uC5B4 \uC0DD\uACBC\uC5B4.\n\n\uC790, \uC774\uC81C \uB188\uC744
      \uC8FD\uC774\uB7EC \uAC00\uC790. \uCF00\uC774\uD0C0\uAC00 \uB450 \uBC88 \uB2E4\uC2DC
      \uBC14\uAE65\uC138\uC0C1 \uB530\uC704\uC5D0 \uAD00\uC2EC\uC744 \uAC00\uC9C0\uC9C0
      \uC54A\uB3C4\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 496924155904
    m_Localized: "\uBBF8\uC640\uC758 \uC77C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4028596867620864
    m_Localized: "\uC624\uB298, \uADF8 \uC544\uC774\uB294 \uB610 \uBC25\uC744 \uB0A8\uACBC\uB2E4.
      \uC77C\uBD80\uB7EC \"\uC120\uB3C4\uAC00 \uB5A8\uC5B4\uC9C4 \uADF8\uAC83\"\uC744
      \uB0B4\uB1A8\uC73C\uB2C8, \uB0A8\uAE30\uB294 \uAC74 \uC608\uC0C1\uD588\uB358
      \uC77C. \uADF8 \uC560\uB294 \uCC29\uD574\uC11C, \uC369\uC5B4\uAC00\uB294 \uB0C4\uC0C8\uC5D4
      \uBBFC\uAC10\uD558\uAC70\uB4E0. \uD558\uC9C0\uB9CC, \uC774\uAC78\uB85C \uB410\uC5B4.
      \"\uBC25\uC744 \uB0A8\uAE30\uBA74 \uC548 \uB41C\uB2E4.\" \uADF8\uB7F0 \uAC04\uB2E8\uD55C
      \uC57D\uC18D\uC870\uCC28 \uC9C0\uD0A4\uC9C0 \uBABB\uD55C\uB2E4\uBA74, \uADF8\uAC74
      \"\uAD50\uC721\"\uC774 \uD544\uC694\uD558\uB2E4\uB294 \uB73B\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

  m_TableData:
  - m_Id: 634711236608
    m_Localized: Kazuya
    m_Metadata:
      m_Items: []
  - m_Id: 5255258112
    m_Localized: Tomorrow's a holiday! Awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 7222386688
    m_Localized: ...Yeah.
    m_Metadata:
      m_Items: []
  - m_Id: 9231458304
    m_Localized: Hey Keita! Come to my place tomorrow! I found a fun game!
    m_Metadata:
      m_Items: []
  - m_Id: 11169226752
    m_Localized: ...Sorry, I can't tomorrow either. I'm not allowed to go out on
      holidays... Really sorry.
    m_Metadata:
      m_Items: []
  - m_Id: 37756919808
    m_Localized: Aww... Again?
    m_Metadata:
      m_Items: []
  - m_Id: 45658988544
    m_Localized: It's always like this! I've invited you so many times already~ And
      our houses are super close!
    m_Metadata:
      m_Items: []
  - m_Id: 209303953408
    m_Localized: Just once is fine, right? Just tomorrow! Please!
    m_Metadata:
      m_Items: []
  - m_Id: 214941097984
    m_Localized: ...Okay... Just tomorrow.
    m_Metadata:
      m_Items: []
  - m_Id: 336538165248
    m_Localized: Yes!! Then come to my place tomorrow and ring the doorbell!
    m_Metadata:
      m_Items: []

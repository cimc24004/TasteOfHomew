  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FriendInHouse_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: cc3fa30550f24e243b5481a32dc9c92e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6635184128
    m_Localized: Awesome! I'm so glad you came! Thanks!
    m_Metadata:
      m_Items: []
  - m_Id: 8702976000
    m_Localized: ...Yeah. I was a bit nervous coming here.
    m_Metadata:
      m_Items: []
  - m_Id: 11685126144
    m_Localized: I bet. Did your mom let you?
    m_Metadata:
      m_Items: []
  - m_Id: 13463511040
    m_Localized: No... I'm actually not supposed to today either, but I thought it'd
      be okay if she doesn't find out...
    m_Metadata:
      m_Items: []
  - m_Id: 44132261888
    m_Localized: I see... By the way, why aren't you allowed to go out?
    m_Metadata:
      m_Items: []
  - m_Id: 54647382016
    m_Localized: I don't know... I thought it was normal.
    m_Metadata:
      m_Items: []
  - m_Id: 182191972352
    m_Localized: After meeting you, Kazuya, I realized it wasn't normal...
    m_Metadata:
      m_Items: []
  - m_Id: 183970357248
    m_Localized: That's pretty weird parenting...
    m_Metadata:
      m_Items: []
  - m_Id: 185555804160
    m_Localized: Yeah... But when she gets mad, it's really scary...
    m_Metadata:
      m_Items: []
  - m_Id: 228144766976
    m_Localized: Then we definitely can't let her find out today.
    m_Metadata:
      m_Items: []
  - m_Id: 262768746496
    m_Localized: Anyway, let's play some games!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

  m_TableData:
  - m_Id: 4550615040
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 37194883072
    m_Localized: ...Kid. Loafing around here? Well, same as me I guess.
    m_Metadata:
      m_Items: []
  - m_Id: 56014725120
    m_Localized: Lately, that 'weird smell' is back. ...Coming from deep in that
      tunnel, carried by the wind.
    m_Metadata:
      m_Items: []
  - m_Id: 152785707008
    m_Localized: That place has always been like a forbidden zone in this town. Cars
      can't get through, the government gave up on it... Now, no sane person goes
      near it.
    m_Metadata:
      m_Items: []
  - m_Id: 187174805504
    m_Localized: ...Well, none of my business though. ...Kid, aren't you keeping
      your friend waiting? Better get going.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

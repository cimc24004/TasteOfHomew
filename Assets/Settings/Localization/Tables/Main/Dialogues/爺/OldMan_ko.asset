  - m_Id: 37194883072
    m_Localized: "...\uAF2C\uB9C8. \uC774\uB7F0 \uB370\uC11C \uBE48\uB465\uAC70\uB9AC\uACE0
      \uC788\uB098. \uBB50, \uB098\uB791 \uB611\uAC19\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 56014725120
    m_Localized: "\uCD5C\uADFC\uC5D0 \uB610 '\uC774\uC0C1\uD55C \uB0C4\uC0C8'\uAC00
      \uB098\uAE30 \uC2DC\uC791\uD588\uC5B4. ...\uC800 \uD130\uB110 \uC548\uCABD\uC5D0\uC11C
      \uBC14\uB78C\uC744 \uD0C0\uACE0 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 152785707008
    m_Localized: "\uC800\uAE30\uB294 \uB9D0\uC774\uC57C, \uC61B\uB0A0\uBD80\uD130
      \uC774 \uB9C8\uC744\uC758 \uAE08\uC871\uC9C0 \uAC19\uC740 \uACF3\uC774\uC9C0.
      \uCC28\uB3C4 \uBABB \uB2E4\uB2C8\uAC8C \uB418\uACE0, \uD589\uC815\uB3C4 \uD3EC\uAE30\uD588\uC5B4...
      \uC9C0\uAE08\uC740 \uBA40\uCA61\uD55C \uC0AC\uB78C\uC740 \uC544\uBB34\uB3C4
      \uC548 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 187174805504
    m_Localized: "...\uBB50, \uB098\uB791\uC740 \uC0C1\uAD00\uC5C6\uB294 \uC77C\uC774\uC9C0\uB9CC.
      ...\uAF2C\uB9C8, \uCE5C\uAD6C \uAE30\uB2E4\uB9AC\uAC8C \uD558\uB294 \uAC70
      \uC544\uB0D0? \uBE68\uB9AC \uAC00."
    m_Metadata:
      m_Items: []

  m_TableData:
  - m_Id: 94430355456
    m_Localized: Aren't you cold?! Aren't you hungry?! Mommy's right here!
    m_Metadata:
      m_Items: []
  - m_Id: 8279351296
    m_Localized: Where...! Where are you, Kokone?!!!
    m_Metadata:
      m_Items: []
  - m_Id: 62171963392
    m_Localized: I've been searching for days!! Why won't you come out?!!
    m_Metadata:
      m_Items: []
  - m_Id: 76424208384
    m_Localized: Kokone!! Answer me!!!
    m_Metadata:
      m_Items: []
  - m_Id: 635260690432
    m_Localized: Why... why can't I find you...!
    m_Metadata:
      m_Items: []
  - m_Id: 632584724480
    m_Localized: ...Please... even just your voice... let me hear it...
    m_Metadata:
      m_Items: []
  - m_Id: 760074788864
    m_Localized: Kokoneeee!!!!!
    m_Metadata:
      m_Items: []
  - m_Id: 314140581888
    m_Localized: Someone's Mother
    m_Metadata:
      m_Items: []

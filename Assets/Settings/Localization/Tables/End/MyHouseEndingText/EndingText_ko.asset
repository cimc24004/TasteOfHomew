  m_SharedData: {fileID: 11400000, guid: c0035222d8493b841b8a10fd3eeb69ba, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5515304960
    m_Localized: "\uCE74\uC988\uC57C\uB294 \uC774\uBBF8 \uC0B4\uD574\uB2F9\uD588\uB2E4...
      \uC6D0\uD55C\uACFC \uC9C8\uD22C\uC640 \uC2AC\uD514\uC774 \uBAA8\uB450 \uB4A4\uC11E\uC600\uB2E4.\n\uACBD\uCC30\uC774
      \uB3C4\uCC29\uD588\uC744 \uB54C\uB294 \uBBF8\uC640\uB97C \uC7A1\uC744 \uC218
      \uC5C6\uC5C8\uB2E4.\n\uD558\uC9C0\uB9CC \uB098\uB9CC \uC54C\uACE0 \uC788\uB2E4.
      \uADF8 \uC5EC\uC790\uB294 \"\uB3C4\uB9DD\uCE5C\" \uAC8C \uC544\uB2C8\uB2E4.
      \uACBD\uCC30\uC774 \uC654\uC73C\uB2C8\uAE4C \"\uADF8\uB9CC\uB454\" \uAC83\uBFD0\uC774\uB2E4.\n\uB0B4\uAC00
      \uC77D\uC740 \uC77C\uAE30\uC5D0\uB294 \uBD84\uBA85\uD788 \uC801\uD600 \uC788\uC5C8\uB2E4.
      \"\uC6D0\uD558\uB294 \uAC74 \uCF00\uC774\uD0C0\uBFD0.\" \"\uCF00\uC774\uD0C0\uB294
      \uB098\uB9CC \uBCF4\uBA74 \uB41C\uB2E4. \uADF8\uAC83\uC73C\uB85C \uCDA9\uBD84\uD558\uB2E4.\"\n\"\uAD1C\uCC2E\uB2E4\"\uACE0
      \uB9D0\uD558\uB294 \uC5B4\uB978\uB4E4\uC740 \uC544\uBB34\uB3C4 \uBBFF\uC744
      \uC218 \uC5C6\uB2E4. \uBBF8\uC640\uB294 \uC544\uC9C1 \uB098\uB97C \uD3EC\uAE30\uD558\uC9C0
      \uC54A\uC558\uB2E4. \uB098\uB294 \uB3C4\uB9DD\uCE60 \uC218 \uC5C6\uB2E4.\n\uADF8
      \uC5EC\uC790\uC5D0\uAC8C \uB2E4\uC2DC \uBC1C\uACAC\uB418\uAE30\uB97C \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC744 \uBFD0\uC774\uB2E4\u2014\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 178912026624
    m_Localized: "\uB098\uB294 \uACBD\uCC30\uC5D0\uAC8C \uBCF4\uD638\uBC1B\uC558\uB2E4.\n\uB450
      \uAD8C\uC758 \uC77C\uAE30\u2014\u2014\u300C\uB0B4 \uC9C4\uC9DC \uC5C4\uB9C8\uC758
      \uC77C\uAE30\u300D\uC640 \u300C\uBBF8\uC640\uC758 \uC77C\uAE30\u300D\u2014\u2014\uAC00
      \uB0B4 \uB9D0\uC744 \uB4B7\uBC1B\uCE68\uD588\uB2E4. \uC5B4\uB978\uB4E4\uC740
      \uB9D0\uD588\uB2E4. \"\uC0C1\uD669\uC0C1 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\"\uACE0.\n\uD558\uC9C0\uB9CC
      \uC544\uB2C8\uB2E4. \"\uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\"\uB85C \uC774
      \uC190\uC758 \uAC10\uCD09\uC740 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uB294\uB2E4.\n\uC544\uBB34\uB3C4
      \uB0B4 \uAC00\uC2B4\uC18D \uAD6C\uBA4D\uC744 \uBA54\uC6CC\uC8FC\uC9C0 \uC54A\uC558\uB2E4.\n\uCE74\uC988\uC57C\uB97C
      \uC8FD\uAC8C \uD588\uB2E4.\n\uADF8\uB9AC\uACE0 \uB098 \uC790\uC2E0\uC774 \uC0B4\uC778\uC790\uAC00
      \uB418\uC5C8\uB2E4\uB294 \uC0AC\uC2E4.\n\uAC00\uB054 \uAFC8\uC18D\uC5D0\uC11C
      \uC6C3\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4. \uBA40\uACE0 \uB2E4\uC815\uD574\uC11C,
      \uC77C\uAE30\uC5D0\uC11C \uBCF8 \uC9C4\uC9DC \uC5C4\uB9C8\uC758 \uBAA9\uC18C\uB9AC\uC77C\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4. \uD558\uC9C0\uB9CC \uB098\uB294 \uC774\uC81C \uADF8 \uB2E4\uC815\uD568\uC744
      \uBC1B\uC744 \uC790\uACA9\uC774 \uC5C6\uB2E4. \uC65C\uB0D0\uD558\uBA74 \uB0B4
      \uC190\uC740 \uADF8 \uC5EC\uC790\uC640 \uAC19\uC740 \uC0C9\uC774 \uB418\uC5B4\uBC84\uB838\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1621861654528
    m_Localized: "\uC774\uC81C \uC544\uBB34\uAC83\uB3C4... \uB9DB\uC774 \uB098\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2

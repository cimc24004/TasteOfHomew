  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: EndingText_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: c0035222d8493b841b8a10fd3eeb69ba, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5515304960
    m_Localized: "Kazuya has already been killed... A mix of resentment, jealousy,
      and sorrow.\nBy the time the police arrived, they couldn't catch Miwa.\nBut
      only I know the truth. She didn't \"run away.\" She just \"stopped\" because
      the police came.\nThe diary I read said it clearly. \"All I want is Keita.\"
      \"Keita only looks at me. That's enough.\"\nI can't trust any of the adults
      who say \"it'll be okay.\" Miwa hasn't given up on me yet. I can't escape.\nI'm
      just waiting to be found by her again\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 178912026624
    m_Localized: "I was taken into police custody.\nTwo diaries\u2014\"My Real Mother's
      Diary\" and \"Miwa's Diary\"\u2014backed up my story. The adults said, \"You
      had no choice given the situation.\"\nBut that's not true. \"Having no choice\"
      doesn't erase the feeling in these hands.\nNo one filled the hole in my chest.\nI
      let Kazuya die.\nAnd the fact that I became a killer myself.\nSometimes in
      my dreams, I hear laughter. Distant and gentle\u2014maybe it's my real mother's
      voice from the diary. But I'm no longer worthy of that kindness. Because my
      hands have become the same color as that woman's."
    m_Metadata:
      m_Items: []
  - m_Id: 1621861654528
    m_Localized: Nothing... had any taste anymore.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

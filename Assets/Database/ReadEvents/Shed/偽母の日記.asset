  m_Name: "\u507D\u6BCD\u306E\u65E5\u8A18"
  m_EditorClassIdentifier: Assembly-CSharp::ReadableAsset
  id: ParentingJournal
  title: 
  pages:
  - "\u7A93\u306E\u4E2D\u3067\u4E09\u4EBA\u304C\u7B11\u3063\u3066\u3044\u305F\u3002\u3042\u306E\u5973\u3001\u3042\u306E\u7537\u3001\u305D\u3057\u3066\u5065\u592A\u3002\r\n\u79C1\u306F\u5916\u5074\u306B\u7ACB\u305F\u3055\u308C\u3066\u3044\u305F\u3002\u6B32\u3057\u3044\u306E\u306F\u3001\u5065\u592A\u3060\u3051\u3002\u79C1\u306F\u3082\u3046\u6C7A\u3081\u3066\u3044\u308B\u3002\r\n"
  - "\u5BB6\u306B\u5165\u3063\u305F\u3002\u53F0\u6240\u3082\u6D17\u6FEF\u3082\u624B\u4F1D\u3063\u305F\u3002\u52DD\u624B\u53E3\u306E\u7656\u3082\u3001\u9234\u306E\u97F3\u3082\u899A\u3048\u305F\u3002\r\n\u79C1\u306F\u6BCD\u306B\u306A\u308B\u3002\u7D19\u3067\u306F\u306A\u304F\u3001\u4E8B\u5B9F\u3067\u3002\u5065\u592A\u306F\u79C1\u306E\u8155\u3067\u843D\u3061\u7740\u304F\u3002\u305D\u3046\u80B2\u3066\u308B\u3002\r\n"
  - "\u4E09\u4EBA\u306E\u8F2A\u3092\u58CA\u3059\u3002\u9806\u756A\u306F\u540C\u6642\u3002\u7720\u308A\u306E\u5E95\u3067\u3001\u540C\u3058\u6642\u523B\u306B\u7D42\u308F\u3089\u305B\u308B\u3002\r\n\u79C1\u306F\u4E8C\u4EBA\u3092\u6BBA\u3059\u3002\u306F\u3063\u304D\u308A\u66F8\u304F\u3002\u79C1\u306F\u4E8C\u4EBA\u3092\u6BBA\u3059\u3002\u305D\u3057\u3066\u3001\u5065\u592A\u3092\u596A\u3046\u3002\r\n"
  - "\u90E8\u5C4B\u306F\u6697\u3044\u3002\u5BDD\u606F\u306F\u63C3\u3063\u3066\u3044\u305F\u3002\u79C1\u306F\u624B\u3092\u4E0B\u3057\u305F\u3002\u4E8C\u4EBA\u306F\u540C\u6642\u523B\u306B\u6B62\u307E\u3063\u305F\u3002\r\n\u79C1\u306F\u4E8C\u4EBA\u3092\u6BBA\u3057\u305F\u3002\u7720\u3063\u3066\u3044\u308B\u3046\u3061\u306B\u3001\u97F3\u3082\u7ACB\u3066\u305A\u306B\u3002\u7D42\u308F\u3063\u305F\u3002\r\n"
  - "\u63FA\u308A\u304B\u3054\u306E\u5065\u592A\u3092\u62B1\u304D\u4E0A\u3052\u305F\u3002\u79C1\u306F\u8A00\u3063\u305F\u2014\u2014\u300C\u79C1\u304C\u6BCD\u3088\u300D\u3002\r\n\u5065\u592A\u306F\u6CE3\u3044\u305F\u3002\u6CE3\u304D\u58F0\u3054\u3068\u3001\u79C1\u304C\u62B1\u3048\u305F\u3002\u79C1\u306F\u8D64\u3093\u574A\u3092\u596A\u3063\u305F\u3002\u79C1\u306E\u5B50\u306B\u306A\u3063\u305F\u3002\r\n"
  - "\u5302\u3044\u3068\u8272\u306F\u5618\u3092\u3064\u304B\u306A\u3044\u3002\u3060\u304B\u3089\u201C\u767D\u201D\u304C\u8981\u308B\u3002\r\n\u6F02\u767D\u5264\u306F\u3001\u8272\u3092\u596A\u3044\u3001\u5302\u3044\u3092\u920D\u3089\u305B\u3001\u8D77\u304D\u305F\u3053\u3068\u3092\u898B\u3048\u306A\u304F\u3059\u308B\u3002\r\n\u5E8A\u306F\u5C11\u3057\u767D\u629C\u3051\u3057\u305F\u3002\u767D\u306F\u6B63\u3057\u3044\u3002\u6B63\u3057\u3044\u306F\u304D\u308C\u3044\u3002\u79C1\u306F\u5FC5\u8981\u306A\u3060\u3051\u4F7F\u3063\u305F\u3002\r\n"
  - "\u5199\u771F\u3092\u6574\u3048\u305F\u3002\u9854\u306F\u76EE\u7ACB\u305F\u306A\u3044\u3068\u3053\u308D\u304B\u3089\u5C11\u3057\u305A\u3064\u3002\r\n\u5BB6\u306E\u30EB\u30FC\u30EB\u3092\u8CBC\u3063\u305F\r\n\u76E3\u8996\u306E\u76EE\u306F\u30E2\u30CB\u30BF\u30FC\u306B\u96C6\u3081\u305F\u3002\u5065\u592A\u306F\u79C1\u3060\u3051\u3092\u898B\u308B\u3002\u305D\u308C\u3067\u8DB3\u308A\u308B\u3002\r\n"

  m_Script: {fileID: 11500000, guid: 47ac5f7c6dd43f5489b6c59b8d592631, type: 3}
  m_Name: "\u507D\u6BCD\u306E\u65E5\u8A18"
  m_EditorClassIdentifier: Assembly-CSharp::ReadableAsset
  id: ParentingJournal
  title: 
  pages:
  - " \u7A93\u3002\u7A93\u306E\u5411\u3053\u3046\u3002\u4E09\u4EBA\u304C\u7B11\u3063\u3066\u3044\u308B\u3002
    \u300C\u7236\u300D\u300C\u6BCD\u300D\u300C\u8D64\u3093\u574A\u300D\u3002 \u3042\u306E\u5973\u306E\u8155\u306E\u4E2D\u3067\u3001\u8D64\u3093\u574A\u304C\u7B11\u3063\u3066\u3044\u308B\u3002
    \u3042\u308C\u306F\u3001\u79C1\u306E\u5834\u6240\u3002 \u3042\u308C\u306F\u3001\u79C1\u306E\u3082\u306E\u3002
    \u6B32\u3057\u3044\u306E\u306F\u3001\u572D\u592A\u3060\u3051\u3002"
  - "\r\n\u3042\u306E\u4E8C\u4EBA\u3092\u6BBA\u3059\u3002 \u79C1\u304C\u672C\u5F53\u306E\u300C\u6BCD\u300D\u306B\u306A\u308B\u3002
    \u572D\u592A\u3092\u3001\u3042\u306E\u5973\u304B\u3089\u300C\u6551\u3044\u51FA\u3059\u300D\u3002
    \u79C1\u306F\u3082\u3046\u3001\u6C7A\u3081\u3066\u3044\u308B\u3002\r\n"
  - " \u3042\u306E\u5973\u306F\u611A\u304B\u3060\u3002\u79C1\u3092\u4FE1\u3058\u304D\u3063\u3066\u3044\u308B\u3002\u79C1\u306F\u5408\u9375\u3055\u3048\u3082\u6301\u3063\u3066\u3044\u308B\u3002\r\n
    \r\n"
  - "\u591C\u306E\u95C7\u306E\u4E2D\u3001\uFF12\u4EBA\u3092\u6BBA\u3057\u305F\u3001\u3068\u3066\u3082\u9759\u304B\u3060\u3063\u305F\u3002
    \u97F3\u3082\u7ACB\u3066\u305A\u306B\u3001\u7D42\u308F\u3089\u305B\u305F\u3002"
  - " \u63FA\u308A\u304B\u3054\u3067\u7720\u308B\u572D\u592A\u3092\u62B1\u304D\u4E0A\u3052\u305F\u3002
    \u3084\u3063\u3068\u3001\u53D6\u308A\u8FD4\u3057\u305F\u3002 \u79C1\u306E\u8155\u306E\u4E2D\u3067\u3001\u572D\u592A\u304C\u6CE3\u3044\u305F\u3002
    \u5927\u4E08\u592B\u3088\u3002\u3082\u3046\u5927\u4E08\u592B\u3002 \u300C\u79C1\u304C\u3001\u3042\u306A\u305F\u306E\u672C\u5F53\u306E\u304A\u6BCD\u3055\u3093\u3088\u300D
    \u4ECA\u65E5\u304B\u3089\u3001\u3053\u3053\u304C\u3001\u79C1\u3068\u3042\u306A\u305F\u306E\u300C\u304A\u3046\u3061\u300D\u3002"
  - "\u3042\u306E\u4E8C\u4EBA\u3092\u6BBA\u3057\u305F\u5F8C\u3001\u5E8A\u306B\u306F\u8840\u306E\u67D3\u307F\u304C\u5927\u91CF\u306B\u6B8B\u3063\u305F\u3002\u5302\u3044\u3082\u9177\u3044\u3002
    \u3053\u306E\u75D5\u8DE1\u3092\u96A0\u3059\u306B\u306F\u3001\u6F02\u767D\u5264\u3092\u6492\u304F\u306E\u304C\u4E00\u756A\u624B\u3063\u53D6\u308A\u65E9\u304B\u3063\u305F\u3002
    \r\n"
  - "\u79C1\u306F\u4ED5\u4E8B\u3067\u4F7F\u3046\u696D\u52D9\u7528\u306E\u5F37\u529B\u306A\u6F02\u767D\u5264\u3092\u3001\u5E8A\u304C\u6D78\u308B\u307B\u3069\u5927\u91CF\u306B\u6492\u3044\u305F\u3002
    \u3053\u308C\u306A\u3089\u3001\u8840\u306E\u8272\u3082\u3001\u6B7B\u4F53\u306E\u5302\u3044\u3082\u3001\u3053\u3053\u3067\u8D77\u304D\u305F\u3053\u3068\u306E\u8A3C\u62E0\u3082\u3001\u5168\u90E8\u6D88\u3057\u53BB\u308C\u308B\u3002
    \u5E8A\u304C\u307E\u3060\u3089\u306B\u767D\u304F\u8272\u629C\u3051\u3057\u3066\u3057\u307E\u3063\u305F\u304C
    \u3001\u3042\u3044\u3064\u3089\u306E\u75D5\u8DE1\u304C\u6B8B\u308B\u3088\u308A\u306F\u305A\u3063\u3068\u30DE\u30B7\u3060\u3002
    \u3053\u308C\u3067\u3001\u3053\u306E\u5BB6\u306F\u79C1\u3068\u572D\u592A\u3060\u3051\u306E\u300C\u304A\u3046\u3061\u300D\u306B\u306A\u308B\u3002"
  - "\u5BB6\u3092\u5B88\u308B\u305F\u3081\u306E\u30EB\u30FC\u30EB\u3092\u8CBC\u3063\u305F\u3002\u572D\u592A\u306F\u3001\u79C1\u3060\u3051\u3092\u898B\u3066\u3044\u308C\u3070\u3044\u3044\u3002
    \u305D\u306E\u305F\u3081\u306B\u3001\u5BB6\u306E\u3044\u305F\u308B\u3068\u3053\u308D\u306B\u5C0F\u578B\u306E\u76E3\u8996\u30AB\u30E1\u30E9\u3092\u4ED5\u639B\u3051\u305F\u3002\u3053\u308C\u3067\u305A\u3063\u3068\u76E3\u8996\u3067\u304D\u308B\u3002
    \r\n"
  - "\u572D\u592A\u304C\u5C11\u3057\u5927\u304D\u304F\u306A\u3063\u305F\u9803\u3001\u79C1\u306F\u3042\u306E\u5B50\u306B\u300C\u5144\u5F1F\u300D\u304C\u5FC5\u8981\u3060\u3068\u601D\u3063\u305F\u3002
    \u3082\u3063\u3068\u5B8C\u74A7\u306A\u300C\u5BB6\u65CF\u300D\u3092\u4F5C\u308B\u305F\u3081\u306B\u3001\u4F55\u4EBA\u304B\u3001\u826F\u3055\u305D\u3046\u306A\u5B50\u3092\u8FD1\u6240\u304B\u3089\u6301\u3063\u3066\u304D\u305F\u3002"
  - "\u3060\u304C\u3001\u30C0\u30E1\u3060\u3063\u305F\u3002\u3069\u306E\u5B50\u3082\u572D\u592A\u306E\u3088\u3046\u306B\u79C1\u3092\u300C\u304A\u6BCD\u3055\u3093\u300D\u3068\u898B\u306A\u3044\u3002
    \u6CE3\u304D\u53EB\u3076\u3070\u304B\u308A\u3067\u3001\u30EB\u30FC\u30EB\u3092\u5B88\u3089\u306A\u3044\u3002\u3042\u3044\u3064\u3089\u306F\u572D\u592A\u306E\u300C\u5144\u5F1F\u3001\u59C9\u59B9\u300D\u306B\u306F\u306A\u308C\u306A\u304B\u3063\u305F\u3002 "
  - "\u5408\u308F\u306A\u3044\u3084\u3064\u306F\u3001\u5931\u6557\u4F5C\u3060\u3002\u89E3\u4F53\u3059\u308B\u3057\u304B\u306A\u304B\u3063\u305F\u3002\u7D50\u5C40\u3001\u79C1\u306E\u5B50\u306F\u572D\u592A\u3060\u3051\u3067\u3044\u3044\u3002\u3042\u306E\u5B50\u3060\u3051\u304C\u79C1\u306E\u5B8C\u74A7\u306A\u5B50\u3060\u3002"
  - "\u4ECA\u65E5\u3001\u572D\u592A\u304C\u77E5\u3089\u306A\u3044\u5B50\u4F9B\u3068\u6B69\u3044\u3066\u3044\u308B\u306E\u3092\u898B\u305F\u3002
    \u53CB\u9054\uFF1F \u8A31\u3055\u306A\u3044\u3002 \u572D\u592A\u306F\u79C1\u306E\u3082\u306E\u3002\u300C\u30B4\u30DF\u300D\u306F\u3001\u8A31\u3055\u306A\u3044\u3002\u3042\u3044\u3064\u306F..
    \u6BBA\u3059\u3002\r\n"

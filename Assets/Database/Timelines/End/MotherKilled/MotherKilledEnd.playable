  m_Name: TextPlayableAsset
  m_EditorClassIdentifier: Timeline.Samples.Text::Timeline.Samples.TextPlayableAsset
  template:
    color: {r: 1, g: 1, b: 1, a: 1}
    fontSize: 35
    text: "\u50D5\u306F\u8B66\u5BDF\u306B\u4FDD\u8B77\u3055\u308C\u305F\u3002\r\n\u4E8C\u518A\u306E\u65E5\u8A18\u2015\u2015\u300E\u50D5\u306E\u672C\u5F53\u306E\u304A\u6BCD\u3055\u3093\u306E\u65E5\u8A18\u300F
      \u3068\u300E\u7F8E\u548C\u306E\u65E5\u8A18\u300F \u2015\u2015\u304C\u3001\u50D5\u306E\u8A00\u8449\u3092\u88CF\u4ED8\u3051\u305F\u3002
      \u5927\u4EBA\u305F\u3061\u306F\u8A00\u3063\u305F\u3002\u300C\u72B6\u6CC1\u7684\u306B\u4ED5\u65B9\u306A\u304B\u3063\u305F\u300D\u3063\u3066
      \u3002\r\n\u3067\u3082\u3001\u9055\u3046\u3093\u3060\u3002 \u300C\u4ED5\u65B9\u306A\u304B\u3063\u305F\u300D\u3067\u3001\u3053\u306E\u624B\u306E\u611F\u89E6\u306F\u6D88\u3048\u306A\u3044\u3002\r\n\u8AB0\u3082\u50D5\u306E\u80F8\u306E\u4E2D\u306B\u3042\u308B\u7A74\u3092\u57CB\u3081\u3066\u306F\u304F\u308C\u306A\u304B\u3063\u305F
      \u3002\r\n\u548C\u4E5F\u3092\u6B7B\u306A\u3055\u305B\u3066\u3057\u307E\u3063\u305F\u3002
      \r\n\u305D\u3057\u3066\u50D5\u81EA\u8EAB\u304C\u6BBA\u3059\u5074\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3068\u3044\u3046\u4E8B\u5B9F\u3002\r\n\u6642\u3005\u3001\u5922\u306E\u4E2D\u3067\u7B11\u3046\u58F0\u304C\u3059\u308B
      \u3002 \u9060\u304F\u3066\u512A\u3057\u304F\u3066 \u3001\u65E5\u8A18\u3067\u898B\u305F\u3001\u672C\u5F53\u306E\u304A\u6BCD\u3055\u3093\u306E\u58F0\u304B\u3082\u3057\u308C\u306A\u3044\u3002
      \u3067\u3082\u3001\u50D5\u306F\u3082\u3046\u3001\u305D\u306E\u512A\u3057\u3055\u306B\u3075\u3055\u308F\u3057\u304F\u306A\u3044\u3002
      \u3060\u3063\u3066\u3001\u50D5\u306E\u624B\u306F\u3001\u3042\u306E\u5973\u3068\u540C\u3058\u8272\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u304B\u3089\u3002\r\n"

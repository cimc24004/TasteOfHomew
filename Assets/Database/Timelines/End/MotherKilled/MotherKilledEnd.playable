    fontSize: 35
    text: "\u3042\u306E\u591C\u306E\u3053\u3068\u306F\u3001\u65AD\u7247\u3060\u3051\u304C\u9759\u304B\u306B\u8607\u308B\u3002\u624B\u306E\u9707\u3048\u3001\u606F\u3092\u6B62\u3081\u305F\u6642\u9593\u3001\u305D\u3057\u3066\u6697\u95C7\u306E\u4E2D\u3067\u805E\u3044\u305F\u81EA\u5206\u306E\u5FC3\u81D3\u306E\u97F3\u2500\u2500\u305D\u308C\u4EE5\u5916\u306E\u5927\u534A\u306F\u3001\u8A00\u8449\u306B\u306A\u3089\u306A\u3044\u3002\u50D5\u306F\u305F\u3060\u3001\u305D\u306E\u5834\u3067\u819D\u3092\u3064\u304D\u3001\u4E16\u754C\u304C\u3086\u3063\u304F\u308A\u3068\u91CD\u304F\u6C88\u3093\u3067\u3044\u304F\u306E\u3092\u611F\u3058\u305F\u3060\u3051\u3060\u3063\u305F\u3002\n\u8B66\u5BDF\u304C\u6765\u305F\u3068\u304D\u3001\u50D5\u306F\u3082\u3046\u307E\u3068\u3082\u306B\u9854\u3092\u4E0A\u3052\u308B\u3053\u3068\u304C\u3067\u304D\u306A\u304B\u3063\u305F\u3002\u8AAC\u660E\u3059\u308B\u8A00\u8449\u306F\u3042\u308B\u306B\u306F\u3042\u3063\u305F\u304C\u3001\u3069\u308C\u3082\u8584\u304F\u3001\u7D19\u306E\u3088\u3046\u306B\u983C\u308A\u306A\u304B\u3063\u305F\u3002\u7F8E\u548C\u304C\u507D\u306E\u6BCD\u3067\u3001\u3042\u306E\u65E5\u50D5\u304C\u898B\u305F\u3082\u306E\u304C\u4F55\u3060\u3063\u305F\u306E\u304B\u3002\u635C\u67FB\u306F\u7DFB\u5BC6\u306B\u9032\u307F\u3001\u73FE\u5834\u306E\u75D5\u8DE1\u306F\u6570\u3005\u306E\u76EE\u3067\u691C\u8A3C\u3055\u308C\u305F\u3002\u3051\u308C\u3069\u3001\u3069\u3093\u306A\u8A3C\u62E0\u3082\u3001\u50D5\u304C\u62B1\u3048\u3066\u3044\u308B\u91CD\u3055\u3092\u8EFD\u304F\u306F\u3057\u306A\u304B\u3063\u305F\u3002\n\u50D5\u306F\u3001\u81EA\u5206\u306E\u4E2D\u306B\u751F\u307E\u308C\u305F\u3082\u306E\u3068\u3069\u3046\u5411\u304D\u5408\u3048\u3070\u3044\u3044\u306E\u304B\u307E\u3060\u5206\u304B\u3089\u306A\u3044\u3002\u60B2\u3057\u307F\u3068\u6012\u308A\u3068\u3001\u8AAC\u660E\u306E\u3064\u304B\u306A\u3044\u5B89\u5835\u304C\u6DF7\u3056\u308A\u5408\u3063\u305F\u611F\u60C5\u304C\u6E26\u5DFB\u304F\u3002\u8AB0\u304B\u306B\u8CAC\u3081\u3089\u308C\u3066\u3082\u3001\u7F7
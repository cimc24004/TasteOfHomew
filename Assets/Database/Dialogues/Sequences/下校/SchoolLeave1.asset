    text: "\u2026\u2026\u3046\u3093\u3002\u672C\u5F53\u306B\u3054\u3081\u3093\u3002\u524D\u306B\u3061\u3087\u3063\u3068\u5916\u306B\u51FA\u305F\u3068\u304D\u3001\u3059\u3054\u304F\u6012\u3089\u308C\u3066\u2026\u2026\u6016\u304B\u3063\u305F\u3093\u3060\u3002"

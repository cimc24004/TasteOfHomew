    text: "\u3048\u30FC\u30FC\u30FC\u5225\u306B\u3044\u3044\u3058\u3083\u30FC\u3093\u30FC\u30FC\u3002\u3000\u3044\u3064\u3082\u305D\u308C\u3058\u3083\u3093\u3002\u524D\u3082\u3001\u305D\u306E\u524D\u3082\u3001\u305A\u3063\u3068\u524D\u3082\u3002"
